{
  "protocol": "miniswe_closed_loop_tp2ep2_w64_hf_swe_sampling_v2",
  "engine": {
    "tensor_parallel_size": 2,
    "expert_parallel_size": 2,
    "data_parallel_size": 1,
    "gpu_memory_utilization": 0.95,
    "max_model_len": 202752,
    "max_num_seqs_in_batch": 64,
    "max_decoding_seqs": 64,
    "max_num_seqs_in_gpu": 64,
    "decode_reservation_tokens": 1024,
    "max_num_batched_tokens": 65536,
    "engine_prefill_chunk_size": 4096,
    "decode_graph": true,
    "decode_graph_capture_sizes": [1, 2, 4, 8, 16, 24, 32, 48, 64],
    "sparse_attn_score_dtype": "float32",
    "enable_prefix_cache_offload": false
  },
  "agent": {
    "dataset": "SWE-bench/SWE-bench_Lite",
    "split": "test",
    "mini_workers": 64,
    "eval_workers": 16,
    "batch_size": 300,
    "step_limit": 80,
    "wall_time_limit_seconds": 7200,
    "max_tokens": 16384,
    "temperature": 0.7,
    "top_p": 1.0,
    "enable_thinking": true,
    "preserve_thinking": true,
    "cost_tracking": "ignore_errors",
    "cost_limit": 0
  },
  "methods": {
    "rkv-chain": {
      "sparse_method": "rkv", "enable_prefix_caching": true,
      "prefix_cache_mode": "chain", "sink_keep_tokens": 64,
      "recent_keep_tokens": 512, "decode_keep_tokens": 15808,
      "rkv_compression_interval": 128, "rkv_observation_tokens": 8,
      "rkv_alpha": 0.1, "rkv_kernel_size": 7, "rkv_score_chunk_mb": 512
    },
    "snapkv-chain": {
      "sparse_method": "snapkv", "enable_prefix_caching": true,
      "prefix_cache_mode": "chain", "sink_keep_tokens": 64,
      "recent_keep_tokens": 512, "decode_keep_tokens": 15808,
      "observation_window_size": 32, "snapkv_num_full_layers": 0,
      "sparse_prefill_score_mode": "probability"
    },
    "h2o-chain": {
      "sparse_method": "h2o", "enable_prefix_caching": true,
      "prefix_cache_mode": "chain", "h2o_prefill_budget": 16384,
      "h2o_decode_budget": 8192, "h2o_prefill_score_window": 128,
      "h2o_decode_eviction": true, "h2o_decode_eviction_interval": 128,
      "h2o_recent_ratio": 0.5, "sparse_prefill_score_mode": "probability"
    },
    "omnikv-prefix": {
      "sparse_method": "omnikv", "enable_prefix_caching": true,
      "prefix_cache_mode": "radix", "sink_keep_tokens": 64,
      "recent_keep_tokens": 512, "decode_keep_tokens": 1472,
      "full_attention_layers": "auto"
    },
    "quest-prefix": {
      "sparse_method": "quest", "enable_prefix_caching": true,
      "prefix_cache_mode": "radix", "sink_keep_tokens": 64,
      "recent_keep_tokens": 512, "decode_keep_tokens": 1472,
      "quest_chunk_size": 16, "quest_skip_layers": 2
    },
    "vanilla-prefix": {
      "sparse_method": "vanilla", "enable_prefix_caching": true,
      "prefix_cache_mode": "radix"
    },
    "snapkv-no-chain": {
      "sparse_method": "snapkv", "enable_prefix_caching": false,
      "prefix_cache_mode": "auto", "sink_keep_tokens": 64,
      "recent_keep_tokens": 512, "decode_keep_tokens": 15808,
      "observation_window_size": 32, "snapkv_num_full_layers": 0,
      "sparse_prefill_score_mode": "probability"
    }
  },
  "slow_baseline_policy": {
    "pilot_instances": 64,
    "full_generation_limit_seconds": 43200,
    "slowdown_ratio": 4.0
  }
}
