{
  "repo": "${BENCHMARK_REPO}",
  "output_root": "${ABLATION_OUTPUT_ROOT}",
  "scratch_root": "${DECODE_SCRATCH_ROOT}",
  "conda": "${CONDA_EXE}",
  "native_env": "${SPARSE_ENGINE_ENV}",
  "model": "${GLM47_MODEL}",
  "hyper_params": {
    "tensor_parallel_size": 2,
    "expert_parallel_size": 2,
    "data_parallel_size": 1,
    "decode_graph": true,
    "gpu_memory_utilization": 0.9,
    "max_num_batched_tokens": 8192,
    "engine_prefill_chunk_size": 8192,
    "enable_prefix_caching": false,
    "full_attention_layers": "auto",
    "sink_keep_tokens": 64,
    "recent_keep_tokens": 512,
    "decode_keep_tokens": 1472
  },
  "cases": [
    {
      "name": "smoke-profile",
      "batch": 2,
      "variant": "profile",
      "smoke": true
    },
    {
      "name": "smoke-fixed32",
      "batch": 2,
      "variant": "fixed32",
      "smoke": true
    },
    {
      "name": "bs4-1-profile",
      "batch": 4,
      "variant": "profile"
    },
    {
      "name": "bs4-2-fixed32",
      "batch": 4,
      "variant": "fixed32"
    },
    {
      "name": "bs4-3-fixed32",
      "batch": 4,
      "variant": "fixed32"
    },
    {
      "name": "bs4-4-profile",
      "batch": 4,
      "variant": "profile"
    },
    {
      "name": "bs5-1-profile",
      "batch": 5,
      "variant": "profile"
    },
    {
      "name": "bs5-2-fixed32",
      "batch": 5,
      "variant": "fixed32"
    },
    {
      "name": "bs5-3-fixed32",
      "batch": 5,
      "variant": "fixed32"
    },
    {
      "name": "bs5-4-profile",
      "batch": 5,
      "variant": "profile"
    }
  ]
}
