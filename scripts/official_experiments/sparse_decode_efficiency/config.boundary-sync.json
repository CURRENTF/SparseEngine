{
  "measurement_protocol": "boundary_sync_v2",
  "output_root": "${DECODE_OUTPUT_ROOT}",
  "scratch_root": "${DECODE_SCRATCH_ROOT}",
  "conda": "${CONDA_EXE}",
  "native_env": "${SPARSE_ENGINE_ENV}",
  "vllm_env": "${VLLM_ENV}",
  "input_len": 131072,
  "output_len": 2048,
  "decode_window_steps": 256,
  "decode_warmup_steps": 32,
  "num_warmups": 1,
  "num_iters": 3,
  "gpu_memory_utilization": 0.9,
  "case_timeout_s": 57600,
  "idle_timeout_s": 43200,
  "safety_concurrency_limit": 1024,
  "models": {
    "qwen3-30b-fp8": {
      "display_name": "Qwen3-30B-A3B-Instruct-2507-FP8",
      "path": "${QWEN3_MODEL}",
      "tp": 1,
      "ep": 1
    },
    "glm4.7-flash": {
      "display_name": "GLM-4.7-Flash (BF16)",
      "path": "${GLM47_MODEL}",
      "tp": 2,
      "ep": 2
    }
  },
  "methods": {
    "snapkv": {
      "sink_keep_tokens": 64,
      "recent_keep_tokens": 512,
      "decode_keep_tokens": 7616,
      "snapkv_window_size": 32,
      "sparse_prefill_score_mode": "probability"
    },
    "quest": {
      "sink_keep_tokens": 64,
      "recent_keep_tokens": 512,
      "decode_keep_tokens": 1472
    },
    "omnikv": {
      "full_attention_layers": "auto",
      "sink_keep_tokens": 64,
      "recent_keep_tokens": 512,
      "decode_keep_tokens": 1472
    }
  },
  "external_lanes": {
    "tangram-snapkv": {
      "environment_kind": "venv",
      "max_num_batched_tokens": 4096,
      "engine": "vllm",
      "method": "snapkv",
      "backend_label": "tangram-snapkv",
      "env": "${TANGRAM_ENV}",
      "engine_kwargs": {
        "compression_scorer": "snapkv",
        "compression_budget_scope": "uniform",
        "compression_budget_tokens": 8192,
        "compression_n_sink_tokens": 64,
        "compression_window_size": 512,
        "compression_chunk_size": 4096,
        "compression_scorer_options": {
          "window": "32",
          "kernel": "7"
        }
      }
    },
    "hisparse-quest": {
      "environment_kind": "venv",
      "engine": "hisparse",
      "method": "quest",
      "backend_label": "hisparse-quest-pr-series",
      "env": "${HISPARSE_ENV}",
      "engine_kwargs": {
        "hisparse_config": {
          "algorithm": "quest",
          "backend": "fa3",
          "page_size": 16,
          "sparsity_ratio": 0.011764705882352941,
          "num_recent_pages": 32,
          "min_sparse_prompt_len": 0,
          "enable_cuda_graph_retrieval": true
        }
      }
    }
  },
  "unsupported": {
    "glm4.7-flash": {
      "tangram-snapkv": "Pinned Tangram compression rejects GLM MLA.",
      "hisparse-quest": "Pinned HiSparse QuEST path supports MHA/GQA, not MLA."
    }
  }
}
