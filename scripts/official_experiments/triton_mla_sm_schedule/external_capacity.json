{
  "output_root": "${EXTERNAL_OUTPUT_ROOT}",
  "scratch_root": "${EXTERNAL_SCRATCH_ROOT}",
  "conda": "${CONDA_EXE}",
  "native_env": "${SPARSE_ENGINE_ENV}",
  "vllm_env": "${VLLM_ENV}",
  "input_len": 131072, "output_len": 2048,
  "gpu_memory_utilization": 0.9, "case_timeout_s": 14400,
  "idle_timeout_s": 7200, "safety_concurrency_limit": 1024,
  "models": {
    "qwen3-30b-fp8": {"display_name": "Qwen3-30B-A3B-Instruct-2507-FP8", "path": "${QWEN3_MODEL}", "tp": 1, "ep": 1}
  },
  "methods": {},
  "external_lanes": {
    "tangram-snapkv": {
      "environment_kind": "venv",
      "max_num_batched_tokens": 2048,
      "engine": "vllm", "method": "snapkv", "backend_label": "tangram-snapkv", "env": "${TANGRAM_ENV}",
      "engine_kwargs": {"compression_scorer": "snapkv", "compression_budget_scope": "uniform",
        "compression_budget_tokens": 8192, "compression_n_sink_tokens": 64,
        "compression_window_size": 512, "compression_chunk_size": 2048,
        "compression_scorer_options": {"window": "32", "kernel": "7"}}
    },
    "hisparse-quest": {
      "environment_kind": "venv",
      "engine": "hisparse", "method": "quest", "backend_label": "hisparse-quest-pr-series", "env": "${HISPARSE_ENV}",
      "engine_kwargs": {"hisparse_config": {"algorithm": "quest", "backend": "fa3", "page_size": 16,
        "sparsity_ratio": 0.011764705882352941, "num_recent_pages": 32,
        "min_sparse_prompt_len": 0, "enable_cuda_graph_retrieval": true}}
    }
  }
}
